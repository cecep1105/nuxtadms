# URL internal Django (dibaca SERVER-SIDE saja, spt DJANGO_INTERNAL_URL Next.js)
DJANGO_INTERNAL_URL=http://127.0.0.1:8000/api/v1

# URL Django yang DIPANGGIL LANGSUNG dari browser (spt NEXT_PUBLIC_API_BASE_URL)
NUXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NUXT_PUBLIC_MEDIA_URL=http://127.0.0.1:8000/media
NUXT_PUBLIC_WS_BASE_URL=

# WAJIB diisi acak/rahasia min. 32 karakter (buat dgn `openssl rand -base64 32`)
# -- dipakai nuxt-auth-utils enkripsi sesi (cookie sealed), PADANAN LANGSUNG
# NEXTAUTH_SECRET versi Next.js.
NUXT_SESSION_PASSWORD=
